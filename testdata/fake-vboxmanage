#
# A stand-in for VBoxManage in the tests. It appends its arguments, one per
# line and then a `----` line, to $FAKE_VBOX_DIR/argv.log, and answers from
# $FAKE_VBOX_DIR/<key>.out (stdout), <key>.err (stderr), <key>.exit (exit
# code) and <key>.sleep (seconds to wait first; with <key>.ignoreterm it
# ignores SIGTERM meanwhile). The key is the leading
# arguments joined by `_`, every character but [A-Za-z0-9.-] turned into `_`;
# the longest key that has a file wins, and with none it prints nothing and
# exits 0. A `--passwordfile` argument's file (a named pipe) is copied to
# password.seen and its mode written to password.mode, unless the file
# `nopassword` exists. Its LC_ALL goes to lc_all.seen.
dir="${FAKE_VBOX_DIR:?FAKE_VBOX_DIR is not set}"
for a in "$@"; do
    printf '%s\n' "$a"
done >>"$dir/argv.log"
printf -- '----\n' >>"$dir/argv.log"
printf '%s\n' "${LC_ALL-unset}" >"$dir/lc_all.seen"

key=""
best=""
prev=""
for a in "$@"; do
    if [ "$prev" = "--passwordfile" ] && [ ! -e "$dir/nopassword" ]; then
        cat "$a" >"$dir/password.seen"
        stat -c %a "$a" >"$dir/password.mode"
    fi
    prev="$a"
    part=$(printf '%s' "$a" | tr -c 'A-Za-z0-9.-' '_')
    if [ -z "$key" ]; then key="$part"; else key="${key}_$part"; fi
    for ext in out err exit sleep ignoreterm; do
        if [ -e "$dir/$key.$ext" ]; then best="$key"; fi
    done
done

[ -n "$best" ] || exit 0
[ -e "$dir/$best.ignoreterm" ] && trap '' TERM
[ -e "$dir/$best.sleep" ] && sleep "$(cat "$dir/$best.sleep")"
[ -e "$dir/$best.out" ] && cat "$dir/$best.out"
[ -e "$dir/$best.err" ] && cat "$dir/$best.err" >&2
if [ -e "$dir/$best.exit" ]; then exit "$(cat "$dir/$best.exit")"; fi
exit 0
